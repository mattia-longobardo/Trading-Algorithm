# Copia in .env e compila. Il file .env è in .gitignore: MAI committare chiavi.

TZ=Europe/Rome

# Postgres del progetto
POSTGRES_USER=bot
POSTGRES_DB=etoro_bot
DB_TRADING_PASSWORD=change-me

# Host servito da Traefik (LAN-only: .local; internet: <sub>.longobardo.me)
TRADING_HOST=trading.longobardo.me

# Chiavi eToro e OpenAI: NON vanno qui.
# Sono credenziali personali legate all'identità SSO. Si inseriscono dalla UI,
# in Impostazioni → «Chiavi API personali»: il backend le cifra con AUTH_SECRET
# e le salva su Postgres (tabella user_credentials). Nessuna variabile
# ETORO_API_KEY / ETORO_USER_KEY / OPENAI_API_KEY viene più letta dall'ambiente.

AUTHENTIK_HOST=
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
# Segreto di sessione Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET=

# Segreto DEDICATO alla cifratura delle chiavi personali nel backend (PBKDF2).
# Se lo lasci vuoto vale AUTH_SECRET, come prima. Cambiandolo non si perde
# nulla: la lettura prova anche le derivazioni precedenti e ri-cifra da sola.
# Genera con: openssl rand -base64 32
TRADING_CREDENTIALS_SECRET=

# OBBLIGATORIO. Token condiviso frontend↔backend: il backend rifiuta (401) ogni
# richiesta che non lo porti nell'header X-Trading-Internal-Token, così gli
# header di identità del proxy non sono falsificabili da dentro la rete Docker.
# Se è vuoto il backend NON parte (unica deroga: TRADING_DEV_MODE=1, solo per
# lo sviluppo in locale — mai in produzione).
# Genera con: openssl rand -base64 32
TRADING_INTERNAL_TOKEN=
